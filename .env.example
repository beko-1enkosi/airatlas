# PostgreSQL connection placeholder. Set in the process environment.
AIRATLAS_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/airatlas

# OpenAQ API key. Set this in your environment; never commit a real key.
OPENAQ_API_KEY=

# dbt PostgreSQL connection components; independent of AIRATLAS_DATABASE_URL.
AIRATLAS_DB_HOST=localhost
AIRATLAS_DB_PORT=5432
AIRATLAS_DB_NAME=airatlas
AIRATLAS_DB_USER=
AIRATLAS_DB_PASSWORD=
AIRATLAS_DBT_SCHEMA=airatlas_analytics
