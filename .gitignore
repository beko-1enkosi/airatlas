# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE configuration
.idea/
.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*~
tmp/
temp/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Local database files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Generated datasets; retain directory placeholders
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/curated/*
!/data/curated/.gitkeep

# dbt-generated artifacts; project, profiles, models and tests remain tracked.
/dbt/target/
/dbt/logs/
/dbt/dbt_packages/
/dbt/.user.yml

# Repository-local Airflow runtime state; DAGs and requirements remain tracked.
/airflow/logs/
/airflow/airflow.cfg
/airflow/airflow.db*
/airflow/webserver_config.py
/airflow/standalone_admin_password.txt
/airflow/simple_auth_manager_passwords.json*
/airflow/airflow-webserver.pid
/airflow/airflow-scheduler.pid
